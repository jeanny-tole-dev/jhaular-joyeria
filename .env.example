# Copia este archivo a .env.local y pon tus valores reales.
# .env.local NUNCA se sube a git (ya está en .gitignore por defecto de Vite).

# Dashboard de Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Estas dos SOLO se configuran en Vercel (Environment Variables),
# nunca en VITE_*, porque no deben llegar al navegador.
# SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
